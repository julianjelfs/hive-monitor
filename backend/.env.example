# Copied to .env by deploy/install-pi.sh. Only the Pi holds the real one (chmod 600).

# The login you use in the Hive app.
HIVE_USERNAME=
HIVE_PASSWORD=

# Pick something long and random, then subscribe to it in the ntfy app on your phone.
# Anyone who knows it can read the alerts, so keep it out of git.
NTFY_TOPIC=

# Optional: a healthchecks.io ping URL. Pinged every poll; healthchecks.io alerts you when
# the pings stop, which covers the Pi dying or the broadband going down.
HEARTBEAT_URL=

# POLL_SECONDS=60
# CONFIRM_AFTER=2
